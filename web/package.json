{
  "name": "baba-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "//typescript": "typescript is held at ^6, NOT ^7: @sveltejs/kit 3.1.0 (latest) declares peerOptional typescript ^6.0.0, and svelte-check 4.7.7 ^5.0.0 || ^6.0.0, so TS 7 (the native compiler) fails to resolve. Nothing else blocks it — raise this the moment kit widens that peer range. Verified 2026-10-24.",
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@types/node": "^26.6.5",
    "svelte-check": "^4.7.7",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
