# BABA configuration — copy to .env and edit
# Paths set in .env are bind-mounted into containers via docker-compose.

# =========================================================================
# Storage paths (host)
# =========================================================================
# Fast tier (SSD/NVMe): models + postgres state.
# Place on the same ZFS pool as the rest of /mnt/docker.
# (App logs go to stdout with docker json-file rotation — no log dir needed.)
BABA_MODELS_HOST=/mnt/docker/baba/models
BABA_STATE_HOST=/mnt/docker/baba/state

# Media tier: everything the cameras produce — continuous video segments
# (LARGE, ~300 GB/day for 7 cameras), crops, clips, thumbnails, face/scene
# crops, reference photos, plate crops. Point it at one CMR disk/pool with
# capacity; an SMR disk is the one thing to avoid, the small files punish it.
# Examples: /mnt/camera/baba, /mnt/storage/cctv, /tank/baba
BABA_MEDIA_HOST=/mnt/docker/baba/media

# =========================================================================
# Hardware variant
# =========================================================================
# One knob to pick the inference/runtime hardware for the WHOLE stack.
# Every BABA service inherits this (detector, embedder, ingestor, api,
# tracker, recorder, event-manager) via docker-compose.yml interpolation.
# Options: cpu (works anywhere), nvidia, intel.
# Per-service overrides exist (BABA_<SERVICE>_VARIANT=...) but you rarely
# need them — the whole stack typically lives on one host.
# The install.sh wizard detects this automatically; manual override
# here is for testing only. Per-service variant overrides
# (BABA_<SERVICE>_VARIANT=…) exist in compose but are intentionally NOT
# listed here — mixing variants inside one stack is an expert footgun
# (you'd need every base image built). If you really know you want
# that, set the env var directly; CLAUDE.md documents the trade-off.
BABA_VARIANT=cpu

# =========================================================================
# Image source (prebuilt registry vs local build)
# =========================================================================
# Where `docker compose pull` finds prebuilt images. A local
# `docker compose build` produces the SAME names, so pull and build are
# interchangeable; install.sh pulls first and falls back to building.
# Override only for a fork/mirror.
#BABA_IMAGE_BASE=ghcr.io/bacinac/baba
# Written by install.sh from the checkout, not edited by hand: on a release
# tag it is that release's version and the image tag becomes
# <variant>-<version> (e.g. nvidia-1.0.1); anywhere else it is empty and the
# moving <variant> tag, i.e. the latest published release, is used.
#BABA_IMAGE_TAG=

# Compose files docker compose merges: the hardware-neutral base + the GPU
# override for your variant. install.sh sets this automatically; if you copy
# this file by hand, match it to BABA_VARIANT:
#   cpu    -> docker-compose.yml
#   nvidia -> docker-compose.yml:docker-compose.nvidia.yml
#   intel  -> docker-compose.yml:docker-compose.intel.yml
COMPOSE_FILE=docker-compose.yml

# The uid:gid the BABA-built services run as (non-root). Default 1000 is
# baked into the images; the bind-mounted models/media/state-api tiers MUST
# be owned by this uid so the services can write (install.sh chowns them; if
# you copy this file by hand, chown them yourself). Change only if you
# rebuilt the images with a different uid. (postgres/nats/go2rtc keep their
# own image user and self-manage their data dirs.)
BABA_UID=1000
BABA_GID=1000

# =========================================================================
# Logging
# =========================================================================
# Verbosity for every service. Default INFO. Set DEBUG here (or per-service,
# e.g. BABA_LOG_LEVEL_DETECTOR=DEBUG) to diagnose an issue, then restart just
# that service — no image rebuild needed. Levels: DEBUG, INFO, WARNING, ERROR.
#BABA_LOG_LEVEL=INFO
# Log format: text (default, human-readable) or json (one structured object per
# line for Loki/Elasticsearch/jq). Applies to all services.
#BABA_LOG_FORMAT=json

# =========================================================================
# Resource governance (SHARED-host only)
# =========================================================================
# Leave empty on a dedicated host — capping BABA there is wrong. When BABA
# shares the box with other stacks, these cap/prioritise the baba.slice cgroup
# (the ML/api services run under it). install.sh applies them via `systemctl
# set-property` (live + persists reboots); the System page then shows BABA's
# own budget instead of the whole host. NOTE: postgres + nats run in a separate
# baba-data.slice, deliberately EXEMPT from this cap so an ML memory spike can't
# OOM-kill the database mid-write (they self-manage their own memory).
#   BABA_MEM_LIMIT   hard RAM ceiling for the ML/api baba containers (e.g. 8G).
#                    Exceeding OOM-kills the largest such process, protecting
#                    co-tenants + the host. The DB is not a candidate victim.
#   BABA_CPU_WEIGHT  scheduler weight (default 100). 1000 = 10x priority under
#                    contention — soft (no idle waste), keeps the real-time
#                    pipeline responsive when a co-tenant pegs the CPU.
#BABA_MEM_LIMIT=8G
#BABA_CPU_WEIGHT=1000

# Self-healing watchdog (default ON for systemd hosts). install.sh installs a
# baba-healwatch.timer that restarts any baba-* container stuck `unhealthy` —
# docker's own restart policy only acts on process EXIT, not on a hard hang that
# trips the healthcheck. Safe: SHM readers share a /dev/shm volume so a restart
# re-attaches cleanly, it keys off beat-based health only (a camera/network
# outage can't trigger a restart storm), and it has a circuit breaker. Set to 0
# to opt out (then a hung container stays unhealthy until you restart it).
#BABA_HEALTH_WATCHDOG=0

# =========================================================================
# Disaster-recovery backup (scripts/backup.sh)
# =========================================================================
# Snapshots ONLY the irreplaceable data — Postgres (identities, embeddings,
# config, users, events) + reference_photos + scene_crops. Video segments,
# crops and thumbnails are EXCLUDED (ephemeral, regenerable). A media-tier
# migration once silently lost every identity reference photo — this is the
# safety net. Run backup.sh manually, or set a schedule below.
#   BABA_BACKUP_HOST   where archives land. For real DR point this at a
#                      DIFFERENT physical disk/host than the data (default is a
#                      ./backups sibling — fine for a first pass, weak for DR).
#   BABA_BACKUP_KEEP   how many archives to retain (default 14).
#   BABA_BACKUP_SCHEDULE  systemd OnCalendar value → install.sh installs a
#                      baba-backup.timer. Empty = no timer (manual only).
#                      Examples: daily | "*-*-* 03:00:00" | weekly
#BABA_BACKUP_HOST=/mnt/backups/baba
#BABA_BACKUP_KEEP=14
#BABA_BACKUP_SCHEDULE=daily

# Intel-only: gid that OWNS the exposed /dev/dri render node on the host.
# docker-compose.intel.yml adds it as a supplementary group so container
# processes can reach the GPU. Find it with `ls -n /dev/dri/renderD*` (3rd
# column) — it is NOT necessarily the `render` group: on a Proxmox LXC the
# passed-through node is often renderD129 owned by a different gid (e.g. 993).
#BABA_INTEL_RENDER_GID=993

# Intel-only: pin the media render node when the host has more than one, or
# when the exposed node isn't ffmpeg's default renderD128.
#   VAAPI needs it named explicitly (default /dev/dri/renderD128).
#   QSV auto-detects a single exposed node; only set this on multi-GPU hosts.
#BABA_VAAPI_DEVICE=/dev/dri/renderD129
#BABA_QSV_DEVICE=/dev/dri/renderD129

# Inference precision for the OpenVINO-backed small models (embedder / face /
# reid / sam2) on the Intel image. FP16 by default: measured against FP32 on
# live crops, the re-ID and face distance drift stays an order of magnitude
# inside the decision margins at ~3-6x the speed. fp32 restores the old path.
#BABA_OPENVINO_PRECISION=fp16

# Every backend follows the service's variant (BABA_VARIANT, or a per-service
# BABA_<SERVICE>_VARIANT) — exactly one per job, and a service whose backend
# is unavailable refuses to start instead of falling back to the CPU:
#
#   variant  decoder (ingestor)   detector     small models (embedder, api, …)
#   nvidia   ffmpeg-nvdec-nv12    tensorrt     onnxruntime CUDA
#   intel    vaapi-nv12           openvino     OpenVINO on the GPU
#   cpu      software             onnxruntime  onnxruntime CPU
#
# The GPU decoders write NV12 to the frame ring and the detector converts it
# on the GPU; the cpu decoder writes RGB. Both services check that contract at
# startup, so a mismatched pair fails loudly instead of dropping every frame.
#
# The decoder is the one choice a host can need to make: an Intel iGPU runs
# qsv-nv12 (Quick Sync, oneVPL), because the N305's VAAPI path dies every
# ~60 s on vaSyncSurface while QSV on the same driver is stable. install.sh
# sets it on an iGPU. Empty = the variant's decoder.
#BABA_DECODER_BACKEND=qsv-nv12

# =========================================================================
# Detector
# =========================================================================
# Default: RT-DETRv2-R18 (Apache 2.0, most-downloaded DETR family on HF).
# Other downloaded variants you can swap in: rtdetrv2-r34/r50/r101.onnx,
# d-fine-n/s/m/l/x.onnx. Frontend will let you switch without re-downloading.
# DO NOT add Ultralytics YOLO weights here — AGPL conflicts with commercial use.
# Users who accept AGPL risk can drop their own yolo*.onnx into /models/ themselves.
# Three model flavours co-exist on disk; detector auto-detects which is
# loaded by reading the engine's input tensor metadata after build:
#   rtdetrv2-r18.onnx        — float32 NCHW. On cpu the detector does
#                              letterbox+normalize+permute on the CPU; on
#                              intel OpenVINO wraps it with an on-device
#                              NV12 PrePostProcessor.
#   rtdetrv2-r18.preproc.onnx — uint8 NHWC RGB. Cast+normalize+permute baked
#                              into the graph. cpu variant only (the only one
#                              whose ring carries RGB). Saves ~5% detector CPU.
#   rtdetrv2-r18.nv12.onnx   — uint8 NV12 flat (B, H+H/2, W). All
#                              YUV→RGB+cast+normalize+permute baked. Required
#                              on nvidia (TensorRT has no PrePostProcessor),
#                              optional on intel.
# Re-bake any of these from the float32 baseline with:
#   python tools/bake_preproc.py -i .../rtdetrv2-r18.onnx \
#       -o .../rtdetrv2-r18.<variant>.onnx --input-format {rgb|nv12}
BABA_DETECTOR_MODEL=/models/rtdetrv2-r18.nv12.onnx
BABA_DETECTOR_BATCH=8
BABA_DETECTOR_BATCH_WAIT_MS=20
BABA_DETECTOR_CONF=0.10
BABA_DETECTOR_INPUT_SIZE=640
# OpenVINO detector precision. Empty = f32/ACCURACY (safe default). "f16" is
# ~3x faster on Intel Arc but historically corrupted SOME models mid-run, so it
# is an explicit opt-in: the backend verifies repeat-stability at load and
# refuses to serve on drift rather than falling back silently.
BABA_DETECTOR_OV_PRECISION=
# Rolling pre-gate detection trace, per camera — the evidence an incident
# replay is built from (Settings → System → incident → "Compare on footage").
# Must outlive the watcher's aggregation delay or a trace is gone before anyone
# asks for it.
BABA_DETECTOR_TRACE_WINDOW_S=1800
BABA_DETECTOR_TRACE_MAX_DETS=32
BABA_DEVICE_ID=0

# =========================================================================
# Tracker (Norfair + OSNet ReID)
# =========================================================================
# COCO class IDs to track. Default covers NVR-relevant subjects.
# 0=person 1=bicycle 2=car 3=motorcycle 5=bus 7=truck 14=bird 15=cat 16=dog
# Leave empty to track all 80 classes (noisy — many false positives).
BABA_TRACKER_CLASSES=0,1,2,3,5,7,14,15,16
# Track lifecycle is configured in SECONDS of wall time (frame counts would
# mean different real durations under the adaptive per-camera rate):
#   LOST_SECONDS      — how long a track survives without a matching detection
#   REID_LOST_SECONDS — how long a dead track waits for an appearance re-match
# With a nano detector (deimv2-n) raise LOST_SECONDS to ~30: class flips into
# NON-tracked classes (a car frame reading as `bench`) starve the track of
# matches, and at 10 s parked objects die + respawn every minute — measured
# 20× object_parked/unparked churn on the .11 Arc deployment until raised.
BABA_TRACKER_LOST_SECONDS=10
BABA_TRACKER_REID_LOST_SECONDS=20
# Nominal tick scale for Norfair's internal frame-based counters — NOT the
# actual processing rate (that's per-camera: cameras.target_fps / idle_fps).
BABA_TRACKER_FPS=15

# Adaptive frame rate (cameras.idle_fps, set per camera in the UI): hysteresis
# before a quiet camera decays to idle_fps, and how stale the tracker's
# activity feed may be before the ingestor forces full rate (fail loud toward
# coverage, never toward blindness).
#BABA_INGESTOR_ACTIVE_HOLD_S=15
#BABA_INGESTOR_ACTIVITY_STALE_S=10

# =========================================================================
# Embedder (DINOv2 body re-ID + optional AuraFace face re-ID)
# =========================================================================
# Body embedder. Missing file → embedder logs warning and uses stub vectors
# (re-ID won't actually match anything, but pipeline keeps running).
BABA_EMBEDDER_MODEL=/models/osnet_x0_25_msmt17.onnx
# Face stack. Both files optional — if either is missing, face-aware re-ID
# is silently disabled and body-only re-ID continues working.
# Fetch via: ./tools/download_models.sh (downloads everything by default).
BABA_FACE_DETECTOR_MODEL=/models/face_yunet.onnx

# =========================================================================
# State-evaluator (scene-state: gate open/closed, door up/down, light on/off)
# =========================================================================
# DINOv2 ViT-S/14 (384-d) general-purpose visual features for few-shot region
# state classification. Distinct from the body re-ID embedder above. Missing
# file → the state-evaluator container crash-loops loudly (fail-loud): scene
# state cannot be classified without it.
BABA_STATE_EVALUATOR_MODEL=/models/dinov2-vits14.onnx

# Plate reading — BYOM, off while empty. Not BABA's to ship: the detector
# derives from YOLOv9 (GPL-3.0) and the OCR weights carry no licence statement
# (LICENSES.md). Naming both fetches them from their authors' releases on first
# start, under terms that are yours.
# Detector: yolov9_s_608 | yolov9_t_384. OCR: cct_s_v1_global | european_vit_v2.
#BABA_PLATE_DETECTOR=yolov9_s_608
#BABA_PLATE_OCR=cct_s_v1_global

# =========================================================================
# Event manager
# =========================================================================
# How long after the last detection before a track is finalized.
BABA_EVENT_TRACK_TIMEOUT_MS=5000
# Tracks shorter than this don't create events (filters out flickers).
BABA_EVENT_MIN_TRACK_LIFETIME_MS=1500
# Min detection count for a track to be considered real.
BABA_EVENT_MIN_OBSERVATIONS=5
# Max width for event thumbnails captured from the recording segment.
BABA_THUMBNAIL_MAX_WIDTH=640
# zone_dwell event fires once after a track has been inside a zone for
# this many ms without leaving. 0 disables. Default 30s catches
# "person loitering in restricted area" without spamming for normal
# passers-by.
BABA_EVENT_DWELL_MS=30000

# =========================================================================
# Recorder
# =========================================================================
# Length of each recorded segment in seconds. Files are clock-aligned, so
# at 300 they cut at 00:00, 00:05, 00:10... Going lower means more files
# (~720/day/cam at 60s); going higher means coarser retention granularity
# and larger crash-loss window. Defaults to 300 (5 min).
BABA_RECORDER_SEGMENT_SECONDS=300

# Socket I/O timeout (seconds) for the recorder's RTSP pull. A stalled camera
# makes ffmpeg exit and reconnect instead of hanging with no segments and no
# error. Defaults to 15.
BABA_RECORDER_RTSP_TIMEOUT_S=15

# =========================================================================
# Postgres
# =========================================================================
POSTGRES_USER=baba
# REQUIRED — no default. install.sh generates a random value; if you copy this
# file by hand, set a strong password here. Compose refuses to start without it
# (rather than silently falling back to a well-known default like `changeme`).
#POSTGRES_PASSWORD=
POSTGRES_DB=baba
# Append ?sslmode=<mode> to every BABA service's Postgres DSN. Empty
# (default) = asyncpg's prefer-then-fallback, which is right for the
# bundled non-TLS Postgres container. For an external managed Postgres
# that enforces TLS (RDS, Cloud SQL, Crunchy, Patroni cluster behind a
# proxy), set to `require` or `verify-full`.
#POSTGRES_SSLMODE=require

# =========================================================================
# NATS authentication (required)
# =========================================================================
# The bus never runs open: the nats container refuses to start and compose
# refuses to render while any of the three below is empty. install.sh generates
# them once and keeps them on every upgrade. Every BABA service's BABA_NATS_URL
# carries this account, which may publish anywhere — it is what BABA's own
# services use.
#NATS_USER=baba
#NATS_PASSWORD=changeme

# The account a REMOTE MIRROR uses (DIDA's baba adapter). Read-only: it may
# subscribe to state, bells and arrivals and ask for the roster, and nothing
# else — so the credential that travels to another site, over a listener that
# may be exposed to the internet, cannot forge state or drive anything. The account is declared in
# the same config as the service account, so an empty password would be an
# account that logs in WITHOUT one; the bus refuses to start rather than serve
# that. install.sh generates it alongside the service credentials; hand it to a
# mirror when you set one up. The mirror takes its replies under `_INBOX.dida`.
#BABA_PEER_NATS_USER=dida
#BABA_PEER_NATS_PASSWORD=changeme

# Where the bus listens on the docker host. 4222 is the raw TCP port; 4223 is the
# same bus over WebSocket, which is what a remote consumer uses when this site is
# reachable only through an HTTP tunnel (a tunnel carries HTTP and WebSocket, not
# a raw port); it speaks TLS, so the tunnel's origin is https://<this host>:4223.
# Publish only what the deployment actually needs.
#BABA_NATS_BIND_IP=0.0.0.0
#BABA_NATS_WS_BIND_IP=0.0.0.0
# Required once either is published: the only hosts, besides BABA's own
# containers, that reach them (comma-separated IPs; deploy/nats-fw.sh).
#BABA_NATS_PEER_IPS=192.0.2.10

# =========================================================================
# go2rtc (RTSP / WebRTC mux) — runs network_mode: host, so it binds these
# ports directly on the docker host. Defaults are the standard go2rtc ports.
# Override ONLY when another go2rtc already holds them — e.g. deploying BABA
# on a host that also runs Frigate (its embedded go2rtc binds 8554/8555).
# Both the go2rtc.yaml listen directives and the services that reach go2rtc
# follow these vars, so a single change here remaps the whole stack.
# Example (BABA alongside Frigate): 11984 / 18554 / 18555.
# =========================================================================
#BABA_GO2RTC_API_PORT=1984
#BABA_GO2RTC_RTSP_PORT=8554
#BABA_GO2RTC_WEBRTC_PORT=8555
# Basic auth on the go2rtc REST API and RTSP. go2rtc is network_mode:host, so
# both are reachable on every host interface, and /api/config answers with every
# camera's plaintext RTSP credentials. Required: nothing starts without it.
# install.sh generates one and keeps it on every upgrade; set one here if you
# copy this file by hand. All internal clients (api, web proxy, healthcheck,
# ingestor and recorder pulls) use it.
BABA_GO2RTC_API_USER=baba
#BABA_GO2RTC_API_PASSWORD=changeme

# =========================================================================
# API
# =========================================================================
BABA_API_PORT=8080

# Bootstrap admin account — created on first boot if `users` table is empty.
# If BABA_ADMIN_PASSWORD is left empty, the api logs a generated password
# at WARNING level once — change it via /account immediately after login.
BABA_ADMIN_USERNAME=admin
BABA_ADMIN_PASSWORD=

# JWT signing key. If left empty, the api generates one and persists it
# to ${BABA_STATE_HOST}/api/secret-key. For multi-instance deployments
# set this explicitly so all api replicas share the secret.
BABA_SECRET_KEY=

# Set to true behind HTTPS (cookie won't be sent over plain HTTP).
# Leave false for local development on http://localhost:5173.
BABA_COOKIE_SECURE=false
# IPs or CIDRs of whatever sits in front of the web port — typically the host
# running cloudflared. Only from these peers does web believe the client
# address they append to X-Forwarded-For; empty = every caller is its own
# client, and all tunnel traffic shares the tunnel host's one login bucket.
BABA_TRUSTED_EDGES=

# CORS origins allowed to call the API (comma-separated, scheme + host + port).
# Empty falls back to a hard-coded dev list (http://localhost:5173,
# http://127.0.0.1:5173). For production, list every external origin the
# SvelteKit app is served from. Use "*" to allow any origin (cookie auth
# still requires credentials: include from the client).
#BABA_CORS_ORIGINS=https://baba.example.com,https://nvr.lan

# AI auto-describe loop: calls the configured AI provider periodically
# to draft labels for newly observed identities. Off by default — costs
# real money per call. Enable only after configuring an API key in
# Settings → AI. Provider keys are stored encrypted in the ai_settings
# table (Fernet, derived from BABA_SECRET_KEY).
BABA_AI_AUTO_DESCRIBE=0
BABA_AI_AUTO_DESCRIBE_INTERVAL_S=120
BABA_AI_AUTO_DESCRIBE_BATCH=5

# Camera slugs that are physical doorbells (comma-separated), e.g. "gate".
# Empty = this install has no doorbell; the doorbell service idles healthy.
# A slug that names a nonexistent camera is a fatal config error on purpose.
BABA_DOORBELL_SLUGS=
